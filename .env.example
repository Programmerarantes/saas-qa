# Ambiente da aplicação
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL local de desenvolvimento
DATABASE_URL=postgres://qa_user:qa_pass@localhost:5432/qa_saas

# PostgreSQL usado pelos testes de API
TEST_DATABASE_URL=postgres://qa_user:qa_pass@localhost:5432/qa_saas_test

# Admin: criado no primeiro boot; nunca envie estas credenciais para o frontend.
ADMIN_EMAIL=admin@softwarequalitylab.local
ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=change-this-admin-secret-in-production
JWT_EXPIRES_IN=8h

# Authentication Lab usa outro banco lógico, sessão e credenciais.
LAB_DEMO_EMAIL=demo@lab.local
LAB_DEMO_PASSWORD=LabPass123!


